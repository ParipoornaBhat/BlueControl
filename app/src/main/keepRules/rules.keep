# Keep all app classes and Bluetooth HID structures from R8 shrinking/obfuscation
-keep class com.example.mad_nnm23cs124.** { *; }
-keepclassmembers class com.example.mad_nnm23cs124.** { *; }
-dontwarn com.example.mad_nnm23cs124.**

# Keep Android HID and Support / Material classes
-keep class android.bluetooth.** { *; }
-keep class androidx.core.** { *; }
-keep class com.google.android.material.** { *; }
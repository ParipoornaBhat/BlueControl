<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Top Handle & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bluetooth Device Manager"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDialogClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_device_item"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvHidStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 HID Profile: Registered &amp; Ready"
                    android:textColor="#22C55E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBtAdapterStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth Adapter: Enabled"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:paddingTop="4dp" />

                <Button
                    android:id="@+id/btnEnableBt"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Turn On Bluetooth"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#2563EB"
                    android:visibility="gone"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnMakeDiscoverable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📡 Make Phone Discoverable (Pair Laptop)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="12sp"
                app:insetTop="0dp"
                app:insetBottom="0dp"
                android:backgroundTint="#2563EB"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Broadcasts S23 FE as an Input Device (Keyboard &amp; Mouse) so Laptop can find it."
                android:textColor="#64748B"
                android:textSize="10sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnOpenBtSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="⚙ Open System Bluetooth Settings"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:singleLine="true"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="12sp"
                app:insetTop="0dp"
                app:insetBottom="0dp"
                android:backgroundTint="#334155"
                android:layout_marginBottom="12dp" />

            <!-- Laptop Pairing Guide Card -->
            <LinearLayout
                android:id="@+id/layoutGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_guide_card"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 How to Connect to Laptop as Input Device:"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Unpair phone on Laptop first: If previously paired, Windows cached it as a regular phone, not an input device. Remove it in Windows Bluetooth settings.\n\n2. Tap 'Make Phone Discoverable' above.\n\n3. On Laptop: Go to Settings > Bluetooth &amp; devices > Add device > Bluetooth.\n\n4. Select your phone (it will appear with an input/keyboard icon).\n\n5. Pair and allow connection on both devices. Once paired, tap Connect below anytime!"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Paired Devices Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PAIRED DEVICES"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/btnRefreshDevices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⟳ Refresh"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Device List Container -->
            <LinearLayout
                android:id="@+id/llDeviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_device_item"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No paired Bluetooth devices found"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap 'Make Phone Discoverable' above and pair from your Laptop."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_ambient"
    tools:context=".SplashActivity">

    <!-- Center Hero Section -->
    <RelativeLayout
        android:id="@+id/heroContainer"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center">

        <!-- Outer Ambient Glow Ring -->
        <View
            android:id="@+id/viewGlowRing"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_splash_card"
            android:alpha="0.25" />

        <!-- App Logo Card -->
        <FrameLayout
            android:id="@+id/cardLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_splash_card"
            android:elevation="12dp"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/app_icon"
                android:contentDescription="BlueControl Emblem"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Floating 3D Accent Chips (Corner Mobbin Style) -->
        <TextView
            android:id="@+id/chipBle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_floating_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="⚡ HID BLE"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:elevation="8dp" />

        <TextView
            android:id="@+id/chipTrackpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="36dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_floating_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🖱 Precision Trackpad"
            android:textColor="#F8FAFC"
            android:textSize="10sp"
            android:elevation="8dp" />

        <TextView
            android:id="@+id/chipAirMouse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_floating_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🎯 Gyro Pointer"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:elevation="8dp" />
    </RelativeLayout>

    <!-- Bottom Typography & Status Brand (Fintech Minimalist Style) -->
    <LinearLayout
        android:id="@+id/bottomBrandContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLUE CONTROL"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT-GEN VIRTUAL HID CONTROLLER"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginTop="6dp" />

        <!-- Modern Loading Indicator -->
        <LinearLayout
            android:id="@+id/loadingPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/dotPulse"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_floating_chip"
                android:backgroundTint="#38BDF8"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INITIALIZING PROFILE..."
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
